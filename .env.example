# Names only. Do not put real secrets in this file or commit a filled-in .env.

# Future report storage. Unused in v1; reports live in process memory and the browser that ran the scan.
DATABASE_URL=

# HMAC key for report ids. When unset, v1 uses a non-secret dev constant baked into lib/scan/store.ts.
# Set a long random value before any shared deployment. The dev constant is not an external credential.
SCAN_REPORT_SECRET=

# Shared secret for a future queue worker. Unused in v1. There is no worker process yet.
SCAN_WORKER_SECRET=

# Future Stripe. Do not use live keys. Payments are not wired up.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Future email delivery of reports. Unused in v1.
REPORT_EMAIL_FROM=
RESEND_API_KEY=
